/data/*.json
/data/canvases/
/data/media_previews/
/data/update_backups/
!data/update_config.json

# 生成资产
/assets/input/
/assets/output/
/assets/library/

# 备份
/_backups/
/data/update_backups/

# 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
.vscode/
.idea/

# 环境变量
.env
.env.local

# 打包产物
/packages/
/dist/
*.zip
*.7z

# 系统
Thumbs.db
.DS_Store

# 临时文件（不推送）
